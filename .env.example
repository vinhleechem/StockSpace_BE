# =========================================================================
# StockSpace Environment Variables Configuration (Template)
# Hướng dẫn: Copy file này thành file .env tại thư mục gốc và thay đổi các cấu hình.
# =========================================================================

# Database Configuration
DB_URL=jdbc:postgresql://localhost:5432/stockspace
DB_USERNAME=postgres
DB_PASSWORD=your_database_password_here

# JWT Security Configuration (Đổi secret key này thành chuỗi random dài >= 256-bit trước khi deploy!)
JWT_SECRET=your_secret_key_at_least_32_characters_here
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# Server Configuration
SERVER_PORT=8080
