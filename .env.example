# =========================================================================
# StockSpace — Production Environment Variables
# Hướng dẫn: Copy file này thành .env trên VPS, điền đủ các giá trị
#             KHÔNG commit file .env thật lên git
# =========================================================================

# ─── Database ─────────────────────────────────────────────────────────────
DB_NAME=stockspace
DB_USERNAME=postgres
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Biến này chỉ dùng khi chạy local (Spring đọc trực tiếp)
# Khi chạy Docker Compose, app tự dùng jdbc:postgresql://postgres:5432/stockspace
DB_URL=jdbc:postgresql://localhost:5432/stockspace

# Hibernate DDL — production nên dùng "validate" hoặc "none", dev dùng "update"
DDL_AUTO=update

# ─── JWT ──────────────────────────────────────────────────────────────────
# Sinh random: openssl rand -base64 64
JWT_SECRET=CHANGE_ME_AT_LEAST_64_CHARS_RANDOM_STRING
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# ─── Server ───────────────────────────────────────────────────────────────
SERVER_PORT=8080

# ─── Cloudinary ───────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── VNPAY ────────────────────────────────────────────────────────────────
VNP_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNP_TMN_CODE=your_tmn_code
VNP_HASH_SECRET=your_hash_secret
# ⚠️ Thay localhost bằng IP/domain VPS thật khi deploy
VNP_RETURN_URL=http://YOUR_VPS_IP_OR_DOMAIN/api/auth/vnpay-callback
VNP_FRONTEND_CALLBACK_URL=https://stock-space-nu.vercel.app/wallet/callback

# ─── Mail (Gmail SMTP) ────────────────────────────────────────────────────
# Tạo App Password tại: https://myaccount.google.com/apppasswords
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_16_char_app_password
MAIL_FROM=StockSpace <your_email@gmail.com>

# ─── Google OAuth ─────────────────────────────────────────────────────────
# Tạo tại: https://console.cloud.google.com → Credentials → OAuth 2.0 Client IDs
# ⚠️ Nhớ thêm VPS domain vào Authorized redirect URIs trong Google Console
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=postmessage

# ─── Frontend ─────────────────────────────────────────────────────────────
# URL Frontend (Vercel)
FRONTEND_URL=https://stock-space-nu.vercel.app

# ─── Google Gemini AI ─────────────────────────────────────────────────────
# Lấy API key tại: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.0-flash
GEMINI_MAX_TOKENS=1024
GEMINI_TEMPERATURE=0.7
