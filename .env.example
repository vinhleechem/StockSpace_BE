# =========================================================================
# StockSpace — Production Environment Variables
# Hướng dẫn: Copy file này thành .env trên VPS, điền đủ các giá trị
#             KHÔNG commit file .env thật lên git
# =========================================================================

# ─── Database ─────────────────────────────────────────────────────────────
DB_NAME=stockspace
DB_USERNAME=postgres
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Biến này chỉ dùng khi chạy local (Spring đọc trực tiếp)
# Khi chạy Docker Compose, app tự dùng jdbc:postgresql://postgres:5432/stockspace
DB_URL=jdbc:postgresql://localhost:5432/stockspace

# Toàn bộ schema cũ hiện vẫn dựa vào Hibernate update. Chỉ đổi production sang
# validate sau khi mọi module đã có migration tương ứng.
DDL_AUTO=update
# `schema.sql` phải chạy trước JPA để cài extension vector.
SPRING_SQL_INIT_MODE=always

# ─── JWT ──────────────────────────────────────────────────────────────────
# Sinh random: openssl rand -base64 64
JWT_SECRET=CHANGE_ME_AT_LEAST_64_CHARS_RANDOM_STRING
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# ─── Server ───────────────────────────────────────────────────────────────
SERVER_PORT=8080

# Đặt true sau khi domain public đã dùng HTTPS qua CDN/load balancer hoặc
# block TLS trong nginx/nginx.conf đã được cấu hình bằng certificate thật.
PUBLIC_HTTPS_READY=false
# Chỉ dành cho test nội bộ qua HTTP tạm thời. Không bật trên production public.
ALLOW_INSECURE_HTTP=false

# ─── Cloudinary ───────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── VNPAY ────────────────────────────────────────────────────────────────
VNP_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNP_TMN_CODE=your_tmn_code
VNP_HASH_SECRET=your_hash_secret
# ⚠️ Thay localhost bằng IP/domain VPS thật khi deploy
VNP_RETURN_URL=http://YOUR_VPS_IP_OR_DOMAIN/api/auth/vnpay-callback
VNP_FRONTEND_CALLBACK_URL=https://stock-space-nu.vercel.app/wallet/callback

# ─── Mail (Gmail SMTP) ────────────────────────────────────────────────────
# Tạo App Password tại: https://myaccount.google.com/apppasswords
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_16_char_app_password
MAIL_FROM=StockSpace <your_email@gmail.com>

# ─── Google OAuth ─────────────────────────────────────────────────────────
# Tạo tại: https://console.cloud.google.com → Credentials → OAuth 2.0 Client IDs
# ⚠️ Nhớ thêm VPS domain vào Authorized redirect URIs trong Google Console
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=postmessage

# ─── Frontend ─────────────────────────────────────────────────────────────
# URL Frontend (Vercel)
FRONTEND_URL=https://stock-space-nu.vercel.app

# ─── OpenRouter AI ────────────────────────────────────────────────────────
# Lấy API key tại: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key
# Chọn model hỗ trợ tools và endpoint ZDR. Không dùng model :free cho dữ liệu
# hợp đồng/ví/tồn kho cá nhân.
OPENROUTER_MODEL=your_zdr_tool_calling_model
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
OPENROUTER_EMBEDDING_DIMENSIONS=1536
OPENROUTER_EMBEDDING_TIMEOUT_MS=3000
OPENROUTER_EMBEDDING_MAX_CONCURRENT_REQUESTS=8
OPENROUTER_MAX_TOKENS=1024
OPENROUTER_TEMPERATURE=0.2
OPENROUTER_DATA_COLLECTION=deny
OPENROUTER_ZDR=true

# Timeout SSE phải lớn hơn deadline xử lý chatbot; heartbeat phải ngắn hơn
# idle timeout của Nginx/CDN. Worker dùng pool và queue có giới hạn.
CHATBOT_SSE_TIMEOUT=90s
CHATBOT_SSE_HEARTBEAT=15s
CHATBOT_SSE_EXECUTOR_CORE=4
CHATBOT_SSE_EXECUTOR_MAX=12
CHATBOT_SSE_EXECUTOR_QUEUE=24

# RAG indexer chạy nền sau khi ứng dụng sẵn sàng; không gọi mạng trong DataInitializer.
CHATBOT_RAG_INDEXER_ENABLED=true
CHATBOT_RAG_INDEXER_BATCH_SIZE=32
CHATBOT_RAG_INDEXER_INTERVAL_MS=3600000
CHATBOT_RAG_INDEXER_INITIAL_DELAY_MS=60000
# Tắt cờ read-path đầu tiên để rollback tức thì về TEXT/JVM trong một release.
CHATBOT_PGVECTOR_ENABLED=true
# Giữ bật để DB mới do Hibernate tạo vẫn nhận constraint và HNSW index.
CHATBOT_PGVECTOR_SCHEMA_INITIALIZER_ENABLED=true
# HNSW search breadth; tăng nếu filter category/model làm recall thấp.
CHATBOT_PGVECTOR_EF_SEARCH=100
CHATBOT_USER_REQUESTS_PER_MINUTE=20
CHATBOT_USER_MAX_CONCURRENT=2

# Chỉ bật chủ động ở máy dev khi thực sự cần các tài khoản demo.
SEED_DEMO_USERS=false
